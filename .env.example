# Скопируйте в .env и впишите значения. Файл .env не попадает в Git.
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram user_id (подскажет `python -m freelance_bot setup-telegram`).
TELEGRAM_OWNER_ID=
# Необязательно: ключ Anthropic для черновиков через Claude. Пусто — встроенный генератор.
ANTHROPIC_API_KEY=
# Модель Claude для черновиков.
LLM_MODEL=claude-sonnet-5-5
# Необязательно: ключ OpenAI (GPT). Задан — черновики и суть заказа пишет GPT, а не Claude
# (даже если ANTHROPIC_API_KEY тоже задан).
OPENAI_API_KEY=
# Модель GPT. gpt-5-mini — быстро и дёшево; gpt-5 — тексты лучше, дороже.
OPENAI_MODEL=gpt-5-mini
# Необязательно: ключ Groq (https://console.groq.com/keys, есть бесплатный тариф). Задан —
# черновики и суть пишет модель Groq, даже если ключи OpenAI и Anthropic тоже заданы.
GROQ_API_KEY=
# Модель Groq. openai/gpt-oss-120b — лучший русский текст; openai/gpt-oss-20b — быстрее;
# llama-3.3-70b-versatile — без рассуждения.
GROQ_MODEL=openai/gpt-oss-120b
# Необязательно: вакансии HH.ru из бота @hh_rabota_bot в вашем Telegram (ADR 0009).
# Все три пишет команда `python -m freelance_bot hh-login`. api_id и api_hash — с
# https://my.telegram.org (API development tools). Сессия даёт полный доступ к аккаунту
# Telegram: никому не показывайте, отозвать — Настройки → Устройства → «freelance-bot (HH)».
HH_TG_API_ID=
HH_TG_API_HASH=
HH_TG_SESSION=
# Необязательно: сессия аккаунта исполнителя Work-zilla для ленты заданий (ADR 0010). Обе пишет
# `python -m freelance_bot workzilla-session --from <API_ANYTHING_HOME>/sessions/work-zilla.json`.
# Cookie Bearer — вход в аккаунт: никому не показывайте.
WORKZILLA_COOKIE=
WORKZILLA_AGENT_ID=

# SuperJob — вакансии через официальный API (ADR 0012): ключ приложения (Secret key) со
# страницы https://api.superjob.ru/info/ после регистрации на https://api.superjob.ru/register/.
SUPERJOB_API_KEY=
